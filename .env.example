# Copy this file to .env and fill in values. .env is gitignored.

# === LLM providers ===
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Generation-side default (overridable per task via TaskConfig.llm_model)
LLMX_DEFAULT_PROVIDER=openrouter
LLMX_DEFAULT_MODEL=deepseek/deepseek-chat

# Judge-side (FIXED — keep stable across all tasks for consistent QA semantics).
# V0.1: Ling 2.6 1T via OpenRouter free tier (no Anthropic key yet).
# Future: switch to anthropic / claude-opus-4-7 when an Anthropic key is available.
LLMX_JUDGE_PROVIDER=openrouter
LLMX_JUDGE_MODEL=inclusionai/ling-2.6-1t:free

# === Database ===
# For local development with SQLite, set:
#   LLMX_DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Leave empty to use the postgres_* fields below (production / docker compose).
LLMX_DATABASE_URL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=llmx_advocate
POSTGRES_USER=llmx
POSTGRES_PASSWORD=change_me

# === Redis (Celery broker + result backend) ===
REDIS_URL=redis://localhost:6379/0

# === MinIO (object storage for large outputs) ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=llmx-advocate
MINIO_SECURE=false

# === API ===
LLMX_API_HOST=0.0.0.0
LLMX_API_PORT=8000
LLMX_API_BASE_URL=http://localhost:8000
# Comma-separated CORS origins (Vite dev server defaults to 5173)
LLMX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Logging ===
LLMX_LOG_LEVEL=INFO

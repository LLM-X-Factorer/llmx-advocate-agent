<?xml version="1.0" encoding="UTF-8"?>
<!--
  Launchd plist for advocate's "push outputs to GitHub" cron.
  Runs every hour at :30 (offset from consume so they don't fight on git lock).

  Install: copy to ~/Library/LaunchAgents/ replacing __PLACEHOLDERS__,
  then `launchctl load ~/Library/LaunchAgents/com.llmxfactors.advocate.push.plist`

  Replace before installing:
    __PROJECT_DIR__               full path to this repo
    __OUTPUTS_SRC_DIR__           the engine's mounted output dir
                                  (typically __PROJECT_DIR__/outputs)
    __ADVOCATE_OUTPUTS_REPO_DIR__ full path to llmx-advocate-outputs working copy
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.llmxfactors.advocate.push</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/cron-push-outputs.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>OUTPUTS_SRC_DIR</key>
        <string>__OUTPUTS_SRC_DIR__</string>
        <key>ADVOCATE_OUTPUTS_REPO_DIR</key>
        <string>__ADVOCATE_OUTPUTS_REPO_DIR__</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key><integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/push.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/push.err.log</string>
</dict>
</plist>
